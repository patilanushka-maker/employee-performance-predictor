# Environment Configuration Template
# Duplicate this file as '.env' and populate with local runtime values.
# Never commit actual secret values or credentials to version control.

ENVIRONMENT=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# Optional Database connection credentials (if using SQL integration)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=employee_performance_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
